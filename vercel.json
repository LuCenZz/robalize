{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/jira-proxy/:path*", "destination": "/api/jira-proxy" },
    { "source": "/legacy", "destination": "/index.html" },
    { "source": "/legacy/:path*", "destination": "/index.html" },
    { "source": "/lite", "destination": "/lite/index.html" },
    { "source": "/lite/", "destination": "/lite/index.html" },
    { "source": "/((?!api/|legacy|lite/).*)", "destination": "/lite/index.html" }
  ]
}
