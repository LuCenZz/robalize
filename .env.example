VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-side JIRA credentials (lite app: no user login)
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-jira-api-token

# Org-wide default JQL for the lite app (each visitor can still override
# their own in the JIRA connector, saved to their browser's localStorage)
JIRA_DEFAULT_JQL=project = "ACTO" AND issuetype = Epic ORDER BY key ASC
